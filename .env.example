# Copy to .env and replace every placeholder before starting.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=replace-with-a-long-opencode-password
# Absolute project directory OpenCode should edit.
WORKDIR=C:\Github\zapcode

EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=replace-with-a-random-32-byte-key
EVOLUTION_INSTANCE=zapcode

# Your personal number that sends messages (not the number linked to Evolution).
ALLOWED_NUMBER=55DDDNUMBER
WEBHOOK_SECRET=replace-with-another-random-32-byte-secret
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional bridge port; defaults to 3000.
PORT=3000
